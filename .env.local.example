# Google OAuth (required for Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-deployment-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional live data sources — omitted keys fall back to mock data automatically
NEXT_PUBLIC_EVENTBRITE_API_KEY=
NEXT_PUBLIC_DICE_API_KEY=
NEXT_PUBLIC_OPENTABLE_API_KEY=
NEXT_PUBLIC_OPENWEATHER_API_KEY=
